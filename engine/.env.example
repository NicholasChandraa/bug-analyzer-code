# Engine (Python/FastAPI) - milik LangGraph/DeepAgents reasoning loop.
# DATABASE_URL: dipakai HANYA buat tabel checkpointer LangGraph (tabel terpisah dari Drizzle).
# LLM_*: provider-agnostic, sama kayak backend (SumoPod/dll).
# BACKEND_URL: base URL backend Hono buat 2 endpoint internal (resolve repo, submit bug report).

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db
BACKEND_URL=http://localhost:3001

LLM_API_KEY=APIKEY
LLM_BASE_URL=https://ai.sumopod.com/v1
LLM_MODEL=deepseek-v4-flash

# Override kalau rg gak di PATH (Windows: choco/winget install ripgrep; Linux: apt install ripgrep)
# RIPGREP_PATH=rg

# Path file log. Default: <repo-root>/logs/app.log (auto-rotate 10MB, keep 5 file).
# Set "" kalau mau disable file logging (cuma stdout).
# LOG_FILE_PATH=